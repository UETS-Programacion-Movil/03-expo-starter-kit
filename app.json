{
  "expo": {
    "name": "Bar Salesiano - William Ortiz ",
    "slug": "bar-salesiano-william-ortiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barsalesianowilliam",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-asset"
    ],
    "extra": {
      "school": "Unidad Educativa Tecnico Salesiano",
      "module": "Programacion Movil 3 BGU",
      "teacher": "Ing. Milton Velasquez",
      "year": "2026-2027"
    }
  }
}
